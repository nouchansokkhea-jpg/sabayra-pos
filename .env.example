APP_NAME="SABAYRA Cambodia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Phnom_Penh
APP_URL=http://localhost:8000
QR_BASE_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# Database Configuration (Supabase PostgreSQL)
# --------------------------------------------------------------------------
# Set to 'supabase' or 'pgsql' for PostgreSQL connection
DB_CONNECTION=supabase
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=menuhub_db
DB_USERNAME=postgres
DB_PASSWORD=YOUR_PASSWORD
DB_SSLMODE=prefer
DB_URL=

# Supabase Storage & Assets
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=menuhub-assets
SUPABASE_VERIFY_SSL=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=supabase
QUEUE_CONNECTION=database

CACHE_STORE=database

# --------------------------------------------------------------------------
# Supabase Storage S3-Compatible Configuration
# --------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_STORAGE_BUCKET=menuhub-assets
SUPABASE_STORAGE_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public

AWS_ACCESS_KEY_ID=YOUR_PROJECT_REF
AWS_SECRET_ACCESS_KEY=YOUR_SUPABASE_STORAGE_SECRET
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=menuhub-assets
AWS_URL=
AWS_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_URL=
REDIS_USERNAME=

# --------------------------------------------------------------------------
# MenuHub Business & Localization Defaults
# --------------------------------------------------------------------------
DEFAULT_CURRENCY=USD
DEFAULT_EXCHANGE_RATE_KHR=4100
DEFAULT_TAX_PERCENT=0

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@menuhub.asia"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Telegram Bot Integration (Official Platform Bot)
# --------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SabayraBot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_VERIFICATION_TTL_MINUTES=15
TELEGRAM_VERIFY_SSL=true
TELEGRAM_POLLING_FALLBACK=false

# --------------------------------------------------------------------------
# Cambodian Payment Gateways (NBC Bakong Open API & ABA PayWay)
# --------------------------------------------------------------------------
BAKONG_ENABLED=true
BAKONG_API_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_OPEN_API_TOKEN=
BAKONG_VERIFY_SSL=true

ABA_PAYWAY_ENABLED=true
ABA_PAYWAY_SANDBOX_URL=https://checkout-sandbox.payway.com.kh
ABA_PAYWAY_PRODUCTION_URL=https://checkout.payway.com.kh
ABA_PAYWAY_VERIFY_SSL=true

# --------------------------------------------------------------------------
# SABAYRA AI Center (Provider-Independent: Gemini & OpenAI)
# --------------------------------------------------------------------------
AI_ENABLED=true
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.4
AI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT_SECONDS=30
AI_RETRY_ATTEMPTS=2
AI_DEFAULT_MONTHLY_CREDITS=100
AI_ALLOW_BUSINESS_OVERRIDE=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

VITE_APP_NAME="${APP_NAME}"
